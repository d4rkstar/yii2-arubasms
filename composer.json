{
  "name": "d4rkstar/yii2-arubasms",
  "description": "Yii 2 Aruba SMS Api",
  "keywords": [
    "yii2",
    "extension",
    "aruba",
    "sms"
  ],
  "homepage": "https://github.com/d4rkstar/yii2-arubasms",
  "type": "yii2-extension",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Bruno Salzano",
      "email": "d4rkstar@gmail.com",
      "homepage": "http://www.brunosalzano.com/"
    }
  ],
  "require": {
    "php": ">=8.1",
    "yiisoft/yii2": "~2.0.52",
    "linslin/yii2-curl": "^1.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "yidas/yii2-bower-asset": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "d4rkstar\\arubasms\\": ""
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}